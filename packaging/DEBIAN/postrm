#!/bin/bash
set -e

case "$1" in
    remove)
        echo "PAM CIBA removed but configuration and logs preserved"
        ;;
    purge)
        echo "Purging PAM CIBA completely..."

        rm -rf /etc/pam-ciba

        echo "PAM CIBA completely removed"
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
